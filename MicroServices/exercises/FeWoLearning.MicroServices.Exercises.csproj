<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FeWoLearning.MicroServices.Exercises</RootNamespace>
    <AssemblyName>FeWoLearning.MicroServices.Exercises</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Aspire hosting integrations. Keep this list identical in solutions/.
       All 13.5.3 except Elasticsearch, whose latest stable is 13.3.0 - a known
       lag, documented in MicroServices/README.md, not silently bumped. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.MySql" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Oracle" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.5.3" />
  </ItemGroup>

  <!-- Client integration (ex033, ex034): the SERVICE side of PostgreSQL. Aspire.Npgsql
       is what AddNpgsqlDataSource lives in, and it brings Npgsql itself, which ex034's
       real query uses. Same 13.5.3 as the hosting packages. Keep identical in the sibling. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" Version="13.5.3" />
  </ItemGroup>

  <!-- ex032's init scripts. Real files, because WithInitFiles COPIES what is on disk:
       the annotation's callback enumerates this folder, so an empty or missing one makes
       the exercise grade nothing. They flow to the TEST assembly's output directory
       through the ProjectReference, which is where builder.AppHostDirectory points under
       the harnesses (README section 5). Keep byte-identical in the sibling library. -->
  <ItemGroup>
    <Content Include="initdb\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Service-side rows (021-023) need ASP.NET Core plus the OpenTelemetry,
       service-discovery and resilience packages that Aspire's ServiceDefaults is
       made of. They live in THIS library pair rather than a third pair of
       projects, so the UseSolutions switch stays at one pair - see
       MicroServices/README.md section 5. Keep this list identical in the sibling. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <!-- EF Core, for rows 036-040. The two providers live in BOTH content libraries,
       identically and in one commit, for the same reason the ASP.NET Core set does
       (README section 5): tests/ references exactly ONE of the two, so the UseSolutions
       switch must stay at a single pair. Versions, and why:
         * Microsoft.EntityFrameworkCore.SqlServer 10.0.11 - EF Core ships on the .NET
           10 servicing train, and 10.0.11 is the same band as the installed
           Microsoft.AspNetCore.App 10.0.11 that tests/ already pins TestHost to.
         * Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 - the latest stable; its floor
           of Microsoft.EntityFrameworkCore.Relational [10.0.4, 11.0.0) is satisfied by
           10.0.11, so both providers sit on one EF Core. It pins Npgsql 10.0.3, which
           is why tests/ moved its own Npgsql pin from 10.0.2 to 10.0.3 in the same
           commit - the test and the exercise must never run two different drivers.
       Microsoft.EntityFrameworkCore.Design is deliberately NOT here: nothing in this
       track shells out to `dotnet ef`. The generated-script rows (037, 039) go through
       DatabaseFacade.GenerateCreateScript(), which is runtime API in .Relational, and
       row 038 ships hand-written Migration classes. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>


  <!-- Rows 041-045: MySQL, Oracle and MongoDB. Same terms as every structural extension
       before it (README section 5) - both content libraries, identically, one commit,
       because tests/ references exactly ONE of them and UseSolutions must stay a single
       switch over a single pair.

         * MySql.EntityFrameworkCore 10.0.9 - Oracle's official MySQL provider, and the
           ONLY option on EF Core 10: Pomelo.EntityFrameworkCore.MySql's newest stable
           (9.0.0) hard-caps Microsoft.EntityFrameworkCore.Relational at [9.0.0, 9.0.999]
           and cannot be used beside the 10.0.11 the other four rows sit on. 10.0.9's
           net10.0 group asks for EF Core 10.0.9, which 10.0.11 satisfies.
         * Oracle.EntityFrameworkCore 10.23.26300 - the 10.x line is the EF Core 10 one;
           its Relational floor is [10.0.0, 11.0.0). It brings Oracle.ManagedDataAccess.Core.
         * MongoDB.Driver 3.9.0 - the version Aspire.MongoDB.Driver 13.5.3 pins on
           net10.0. Rows 043-045 use the driver directly (class maps, index models,
           aggregation pipelines) rather than the Aspire client integration, but pinning
           the driver to what that integration resolves means a later row adding
           AddMongoDBClient needs no version bump and cannot end up on two drivers - the
           same rule tests/'s Npgsql pin follows.

       Neither MySQL nor Oracle needs a CONTAINER: rows 041 and 042 read
       DatabaseFacade.GenerateCreateScript(), which opens nothing. Oracle's image is
       ~9 GB and MySQL's ~600 MB; keeping both rows offline is deliberate.

       One measured consequence of four relational providers in one library: extension
       methods with the same name now collide. UseSequence and UseHiLo exist on
       SqlServerPropertyBuilderExtensions, NpgsqlPropertyBuilderExtensions AND
       OraclePropertyBuilderExtensions, all in namespace Microsoft.EntityFrameworkCore,
       so an unqualified call fails CS0121. Call the provider's class by name. -->
  <ItemGroup>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
    <PackageReference Include="MongoDB.Driver" Version="3.9.0" />
  </ItemGroup>

</Project>
