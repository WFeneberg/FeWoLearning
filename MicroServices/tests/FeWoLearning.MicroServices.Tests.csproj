<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FeWoLearning.MicroServices.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xunit.v3 3.2.2 on the classic VSTest path, and NO global.json.
       xunit.v3 4.0.0 + a Microsoft.Testing.Platform global.json makes
       `dotnet test` exit 5 with zero tests discovered on the .NET 10.0.400 SDK.
       runner.visualstudio has no 3.1.6/3.1.7 - 3.1.5 is the last 3.x, and naming
       a nonexistent one resolves FORWARD to 4.0.0 with only an NU1603 warning. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.3" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <!-- Service-side rows (021-023). The in-memory OTel exporter is TEST equipment,
       not exercise content, so it lives here and not in the two content libraries;
       it is pinned to the same 1.18.0 they are. TestHost gives ex023 real /alive
       and /health responses without a socket, and matches the installed
       Microsoft.AspNetCore.App 10.0.11. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
  </ItemGroup>

  <!-- ex034's L3 fact seeds a row through its OWN connection before asking the learner's
       code to read it back, so the test needs a raw Npgsql client of its own. Pinned to
       the exact version Aspire.Npgsql 13.5.3 resolves in the two content libraries, so
       the test and the exercise never run two different drivers. -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Exactly one content library, never both: that is what keeps the identical
       namespaces and type names from colliding. `dotnet test` is the red run,
       `dotnet test -p:UseSolutions=true` the green one. -->
  <ItemGroup Condition="'$(UseSolutions)' != 'true'">
    <ProjectReference Include="..\exercises\FeWoLearning.MicroServices.Exercises.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseSolutions)' == 'true'">
    <ProjectReference Include="..\solutions\FeWoLearning.MicroServices.Solutions.csproj" />
  </ItemGroup>


  <!-- L3 (container) rows only. Starting a real DistributedApplication needs DCP, the
       orchestrator the Aspire.AppHost.Sdk normally supplies; this is a plain test
       project, so the two pieces are pulled in BY HAND and only when -p:Containers=true,
       which already forces a rebuild. The default `dotnet test` therefore restores and
       builds exactly what it did before: no DCP, no Docker, no Aspire CLI.
       The orchestration package's targets set $(DcpDir) to its own tools folder; that
       alone satisfies Aspire.Hosting.AppHost's SetOrchestrationDiscoveryAttributes
       target, which stamps [AssemblyMetadata("dcpclipath"/"dcpextensionpaths")] onto
       THIS test assembly - where Aspire looks for the orchestrator at run time.
       Do NOT set IsAspireHost=true to "make it an AppHost": the .NET 10 SDK's
       _CheckForAspireWorkloadDeprecation fires on IsAspireHost without the
       AspireHostingSDKVersion only the Aspire.AppHost.Sdk sets, and the build dies with
       NETSDK1228 ("depends on the deprecated Aspire workload"). The attribute target
       does not need it. DCP comes from the version-pinned NuGet package rather than
       from whatever the machine's `aspire` CLI happens to have unpacked, so a green
       container run does not depend on the CLI at all. -->
  <ItemGroup Condition="'$(Containers)' == 'true'">
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Orchestration.$(NETCoreSdkRuntimeIdentifier)" Version="13.5.3" />
  </ItemGroup>

  <!-- `-p:Containers=true` reaches the test process through runtimeconfig.json, so it
       needs a build. FEWO_MS_CONTAINERS=1 opens the same GATE without one - but since
       ex034 that is NO LONGER a full substitute, and the difference is not the gate.
       The DCP packages above are conditioned on '$(Containers)', and an environment
       variable cannot add a PackageReference: an L3 row let through by the env var
       alone reaches an orchestrator that was never restored and dies in ~160 ms with
       "OptionsValidationException: Property CliPath: The path to the DCP executable
       used for Aspire orchestration is required."
       That conditioning is deliberate, not an oversight. It is what keeps the default
       `dotnet test` restoring and building exactly what it did before the first
       container row landed - no DCP, no Docker, no RID-specific orchestrator download -
       and the failure above is loud and immediate, so it can never be mistaken for a
       pass. Use FEWO_MS_CONTAINERS=1 to exercise the gate; use -p:Containers=true to
       actually run a container row. See MicroServices/README.md section 3. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="FeWoLearning.MicroServices.Containers"
                                    Value="$(Containers)"
                                    Condition="'$(Containers)' != ''" />
  </ItemGroup>

</Project>
