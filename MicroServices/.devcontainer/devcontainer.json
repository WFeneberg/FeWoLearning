{
  "name": "FeWoLearning MicroServices",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",

  // Not the "docker-outside-of-docker" FEATURE: that feature's apt repo add
  // fails with NO_PUBKEY 62D54FD4003F6525 on this network (see
  // task-4-report.md, fix round 1). Same effect — Aspire's sibling containers
  // land on the HOST daemon, never nested — reached instead by bind-mounting
  // the host socket directly and installing a static `docker` CLI binary that
  // needs no apt repo or GPG key at all.
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],

  // 18888 is the Aspire dashboard.
  "forwardPorts": [18888],
  "portsAttributes": {
    "18888": { "label": "Aspire dashboard", "onAutoForward": "notify" }
  },

  // The base image ships no node/npm (confirmed as both root and vscode), and
  // the "node" feature's apt repo hits the same NO_PUBKEY problem as
  // docker-outside-of-docker. So both docker and node are installed here from
  // plain HTTPS tarballs (no apt, no GPG keyserver, nothing this network's
  // signing-key path can break) rather than from features:
  //  - docker 29.8.0 static client from download.docker.com's static-binary
  //    channel — only the `docker` binary is needed, to talk to the socket
  //    mounted above; no daemon, no docker-in-docker.
  //  - node v24.20.0 (current LTS "Krypton" as of 2026-09-05) from
  //    nodejs.org's own dist tarballs, extracted straight into /usr/local so
  //    `node`/`npm` land on PATH with no further config.
  //  - @microsoft/aspire-cli then installs the normal way, via that npm.
  "postCreateCommand": "set -e; curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-29.8.0.tgz -o /tmp/docker.tgz && sudo tar -xzf /tmp/docker.tgz -C /usr/local/bin --strip-components=1 docker/docker && sudo chmod +x /usr/local/bin/docker && rm -f /tmp/docker.tgz && curl -fsSL https://nodejs.org/dist/v24.20.0/node-v24.20.0-linux-x64.tar.xz -o /tmp/node.tar.xz && sudo tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && rm -f /tmp/node.tar.xz && npm install -g @microsoft/aspire-cli && dotnet restore",

  // The bind-mounted host socket is root:root mode 660 (measured), so the
  // non-root "vscode" user (and Aspire, and every exercise, which all call
  // `docker` without sudo) gets "permission denied" without this. Widening it
  // to 666 is scoped to just this socket, not a broader group/sudo grant, and
  // must be re-applied every start (not just postCreateCommand) because it is
  // the HOST's shared socket file and its mode is not owned by this container.
  "postStartCommand": "sudo chmod 666 /var/run/docker.sock",

  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit"]
    }
  }
}
