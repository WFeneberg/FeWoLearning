@* Exercise 030 — AntiforgeryInEditForm (web-blazor).
   Goal:   Render a form that always carries a fresh, unpredictable
           anti-forgery token alongside its own fields, and invoke
           OnValidSubmit exactly once per valid submission. Implement
           GenerateToken so every component instance gets its own value -
           never one shared constant, and never left empty.
   Drills: EditForm, a fresh antiforgery token per component instance, OnValidSubmit.
   Passes: attack facts - the rendered form's __RequestVerificationToken
                          hidden input always has a non-empty value, and two
                          separately rendered instances of this component
                          produce two DIFFERENT token values (a fixed token
                          is no token at all);
           use facts     - the form's Name/Email fields render with the
                          model's current values, and submitting valid data
                          invokes OnValidSubmit exactly once (counted, not
                          merely observed once). *@

<EditForm Model="Model" OnValidSubmit="HandleValidSubmit">
    <input type="hidden" name="__RequestVerificationToken" value="@Token" />
    <InputText id="name" @bind-Value="Model.Name" />
    <InputText id="email" @bind-Value="Model.Email" />
    <button type="submit">Save</button>
</EditForm>

@code {
    [Parameter] public Ex030_ProfileModel Model { get; set; } = new();
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private string? _token;

    // Shape A: the hidden input above reads this member, and it throws - so
    // no token is ever rendered until this is implemented.
    private string Token => _token ??= GenerateToken();

    private static string GenerateToken() =>
        throw new NotImplementedException(
            "TODO: Ex030 - a fresh, unpredictable token; a different value for every component instance");

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();
}
