<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <RootNamespace>FeWoLearning.Wpf.Exercises</RootNamespace>
    <AssemblyName>FeWoLearning.Wpf.Exercises</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic host, DI, configuration and logging - the tier-2 rows 036-039.
         The only package either content library needs; everything else ships in
         Microsoft.WindowsDesktop.App. Keep both .csproj files identical here. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
