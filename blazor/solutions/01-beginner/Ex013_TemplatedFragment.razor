@typeparam TItem
@* Exercise 013 - Templated Fragment (beginner).
   Goal:   Render a caller-supplied template for each item, with an empty-state fallback.
   Drills: @typeparam, RenderFragment<TItem>, empty template.
   Passes: dotnet test --filter FullyQualifiedName~Ex013_ *@
<div id="repeater">
    @if (Items.Count == 0)
    {
        @Empty
    }
    else
    {
        @foreach (var item in Items)
        {
            <div class="row">
                @if (Row is not null)
                {
                    @Row(item)
                }
                else
                {
                    @item?.ToString()
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter] public RenderFragment<TItem>? Row { get; set; }
    [Parameter] public RenderFragment? Empty { get; set; }
}
