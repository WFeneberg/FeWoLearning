@* Exercise 028 - Cascading Value Basics (beginner).
   Goal:   Consume a cascaded value via [CascadingParameter].
   Drills: [CascadingParameter], falling back when no provider is present.
   Passes: dotnet test --filter FullyQualifiedName~Ex028_ *@
<span id="themed" class="theme-@(Theme ?? "none")">@Text</span>

@code {
    [CascadingParameter] public string? Theme { get; set; }
    [Parameter] public string Text { get; set; } = "";
}
