@* Exercise 006 - Click Event Callback (beginner).
   Goal:   Report the next count through OnLike without storing it.
   Drills: @onclick, EventCallback<T>, stateless child components.
   Passes: dotnet test --filter FullyQualifiedName~Ex006_ *@
<button id="like" @onclick="HandleClickAsync">Like (@Count)</button>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public EventCallback<int> OnLike { get; set; }

    private Task HandleClickAsync() => OnLike.InvokeAsync(Count + 1);
}
