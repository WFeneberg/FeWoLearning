@* Exercise 029 - Named Cascading Value (beginner).
   Goal:   Cascade two values of the same type, told apart only by Name.
   Drills: CascadingValue Name, avoiding ambiguous resolution.
   Passes: dotnet test --filter FullyQualifiedName~Ex029_ *@
<CascadingValue Value="Locale" Name="Locale">
    <CascadingValue Value="Currency" Name="Currency">
        @ChildContent
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public string Locale { get; set; } = "";
    [Parameter] public string Currency { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
