@* Exercise 010 - Bind Event On Input (beginner).
   Goal:   Report the query on every keystroke instead of on blur.
   Drills: hand-wired @oninput vs @onchange timing (no @bind directive).
   Passes: dotnet test --filter FullyQualifiedName~Ex010_ *@
<input id="q" value="@Query" @oninput="OnInputAsync" />
<span id="echo">@Query</span>

@code {
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public EventCallback<string> QueryChanged { get; set; }

    private Task OnInputAsync(ChangeEventArgs e) => QueryChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
