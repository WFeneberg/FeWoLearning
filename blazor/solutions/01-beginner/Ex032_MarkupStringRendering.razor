@* Exercise 032 - MarkupString Rendering (beginner).
   Goal:   Render HTML raw only when explicitly allowed; otherwise show it as
           visible, escaped text.
   Drills: MarkupString, opting out of Blazor's default HTML-encoding.
   Passes: dotnet test --filter FullyQualifiedName~Ex032_ *@
<div id="rich">
    @if (AllowHtml)
    {
        @((MarkupString)Html)
    }
    else
    {
        @Html
    }
</div>

@code {
    [Parameter] public string Html { get; set; } = "";
    [Parameter] public bool AllowHtml { get; set; }
}
