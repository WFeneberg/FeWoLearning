@* Exercise 028 - Cascading Value Basics (beginner).
   Goal:   Cascade a value to descendants without passing it explicitly.
   Drills: CascadingValue, ChildContent.
   Passes: dotnet test --filter FullyQualifiedName~Ex028_ *@
<CascadingValue Value="Theme">@ChildContent</CascadingValue>

@code {
    [Parameter] public string Theme { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
