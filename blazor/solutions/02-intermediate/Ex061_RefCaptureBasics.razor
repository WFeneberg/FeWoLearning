@* Exercise 061 - Ref Capture Basics (intermediate).
   Goal:   Reach the DOM element and the child component instance this component
           rendered, and drive the child by calling a method on it.
   Drills: @ref on an element (ElementReference) and on a component (the instance
           itself), and the fact that both are only populated after a render.
   Passes: dotnet test --filter FullyQualifiedName~Ex061_ *@
<div id="box" @ref="_box">box</div>
<Ex061_RefCaptureBasics_Panel @ref="_panel" />
<button id="open" @onclick="OpenPanel">open</button>

@code {
    private ElementReference _box;
    private Ex061_RefCaptureBasics_Panel? _panel;

    public string ElementId => _box.Id;
    public Ex061_RefCaptureBasics_Panel? Panel => _panel;

    private void OpenPanel() => _panel?.Open();
}
