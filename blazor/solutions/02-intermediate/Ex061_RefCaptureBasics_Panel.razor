@* Exercise 061 - Ref Capture Basics (intermediate) - the child half.
   Goal:   Expose a method the parent can call through its captured @ref.
   Drills: a public method as a component's imperative surface.
   Passes: dotnet test --filter FullyQualifiedName~Ex061_ *@
<span id="panel">@(IsOpen ? "open" : "closed")</span>

@code {
    public bool IsOpen { get; private set; }

    public void Open()
    {
        IsOpen = true;
        // Redundant when the parent's own click re-renders this child anyway, but it
        // is what makes the method safe to call from anywhere else.
        StateHasChanged();
    }
}
