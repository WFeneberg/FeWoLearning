@implements IDisposable
@* Exercise 046 - State Container Notification (intermediate).
   Goal:   Subscribe to an injected store exactly once, no matter how many times this component re-renders.
   Drills: [Inject] on a shared store, subscribe/unsubscribe symmetry, surviving a parameter push without double-subscribing.
   Passes: dotnet test --filter FullyQualifiedName~Ex046_ *@
<span id="label">@Label</span>
<span id="value">@Store.Value</span>

@code {
    [Inject] public CounterStore Store { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Count";

    private Action? _onChanged;

    protected override void OnInitialized()
    {
        _onChanged = StateHasChanged;
        Store.Changed += _onChanged;
    }

    public void Dispose()
    {
        if (_onChanged is not null) Store.Changed -= _onChanged;
    }
}
