@* Exercise 064 - SetParametersAsync Override (intermediate).
   Goal:   See an incoming parameter before it lands, so you can tell a real change
           from a re-set of the same value.
   Drills: overriding SetParametersAsync, reading ParameterView.TryGetValue, and the
           ordering that makes it work - base.SetParametersAsync is what assigns the
           properties and drives the rest of the lifecycle, so it comes last.
   Passes: dotnet test --filter FullyQualifiedName~Ex064_ *@
<span id="value">@Value</span>
<span id="sets">@SetCount</span>
<span id="changes">@ChangeCount</span>

@code {
    [Parameter] public string Value { get; set; } = "";

    public int SetCount { get; private set; }
    public int ChangeCount { get; private set; }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        SetCount++;

        // Value still holds the previous value here - that is the whole point of
        // comparing before handing the ParameterView on.
        if (parameters.TryGetValue<string>(nameof(Value), out var incoming) && incoming != Value)
        {
            ChangeCount++;
        }

        return base.SetParametersAsync(parameters);
    }
}
