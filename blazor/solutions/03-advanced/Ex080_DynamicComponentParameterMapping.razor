@* Exercise 080 - Dynamic Component Parameter Mapping (advanced).
   Goal:   Turn untyped name/value text - a query string, a CMS record, a config
           file - into a parameter dictionary a <DynamicComponent> will accept.
   Drills: reflecting over a component's [Parameter] properties, converting values
           to their declared types, and refusing what does not fit instead of
           letting DynamicComponent throw at render time.
   Passes: dotnet test --filter FullyQualifiedName~Ex080_ *@
<DynamicComponent Type="ComponentType" Parameters="_mapped" />

@code {
    [Parameter] public Type ComponentType { get; set; } = typeof(DynamicBadge);

    /// Raw text, as it would arrive from outside the app.
    [Parameter] public IReadOnlyDictionary<string, string> RawValues { get; set; }
        = new Dictionary<string, string>();

    /// One line per raw entry that could not be mapped. Order follows RawValues.
    public IReadOnlyList<string> Problems { get; private set; } = [];

    public const string UnknownParameter = "unknown parameter";
    public const string NotConvertible = "not convertible";

    private IDictionary<string, object> _mapped = new Dictionary<string, object>();

    // Once per parameter push, not from the markup: a render expression that assigns
    // Problems would be writing state while rendering it.
    protected override void OnParametersSet()
    {
        var mapped = new Dictionary<string, object>();
        var problems = new List<string>();

        foreach (var (name, raw) in RawValues)
        {
            var property = ComponentType.GetProperty(name);

            // Public is not enough: only a [Parameter] property is settable this way.
            if (property is null || !property.IsDefined(typeof(ParameterAttribute), inherit: true))
            {
                problems.Add($"{name}: {UnknownParameter}");
                continue;
            }

            try
            {
                mapped[name] = Convert.ChangeType(raw, property.PropertyType, CultureInfo.InvariantCulture)!;
            }
            catch (Exception e) when (e is FormatException or InvalidCastException or OverflowException)
            {
                problems.Add($"{name}: {NotConvertible}");
            }
        }

        Problems = problems;
        _mapped = mapped;
    }
}
