@page "/beginner/019"
@rendermode InteractiveServer

<h1>Exercise 019 - OnAfterRenderFirst</h1>

<button @onclick="Bump">Bump label</button>

<Ex019_OnAfterRenderFirst Label="@_label" />

@code {
    private string _label = "start";
    private int _bumps;

    private void Bump()
    {
        _bumps++;
        _label = $"bump {_bumps}";
    }
}
