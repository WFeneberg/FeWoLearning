<!-- Exercise 056 - DataGridColumns (intermediate).
     Goal:   Render a row collection through a DataGrid with explicitly declared
     columns (not auto-generated), and make one column sortable by driving it
     programmatically.
     Drills: DataGrid.Columns, DataGridTextColumn.Binding, AutoGenerateColumns,
     DataGridColumn.Sort.
     Passes: dotnet test, filtered to Ex056_ (see
     Ex056_DataGridColumns.axaml.cs for the exact command - an XML comment
     cannot hold two hyphens in a row). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FeWoLearning.Avalonia.Exercises.Intermediate"
             x:Class="FeWoLearning.Avalonia.Exercises.Intermediate.Ex056_DataGridColumns"
             x:DataType="i:Ex056_DataGridColumnsViewModel">
  <!-- TODO: DataGrid is not in core Avalonia - it lives in the
       Avalonia.Controls.DataGrid package, already referenced for you - and it
       renders NOTHING at all without its theme, silently: no error, just an
       empty grid. Replace the placeholder with:
         <UserControl.Styles>
           <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
         </UserControl.Styles>
         <DataGrid Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False">
           <DataGrid.Columns>
             <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
             <DataGridTextColumn Header="Age" Binding="{Binding Age}" />
           </DataGrid.Columns>
         </DataGrid>
       Note DataGridTextColumn.Binding is a plain {Binding}, not a compiled one.
       AutoGenerateColumns="True" would produce columns too, without you
       declaring any - the test checks IsAutoGenerated is false on each
       declared column, which a hard-coded auto-generate never satisfies. The
       test also grabs Columns[0] and calls Sort on it directly (there is no
       real header click in a headless test) and checks the rendered row
       order actually changes - a grid that never re-sorts, or one that only
       LOOKS sorted because the source happened to already be in that order,
       both fail that half. -->
  <StackPanel>
    <TextBlock Text="TODO" />
  </StackPanel>
</UserControl>
