<!-- Exercise 016 - ReactiveCommandBasics (beginner).
     Goal:   Wire a Button's Command to a parameterless ReactiveCommand and
             show the result it produces.
     Drills: ReactiveCommand.Create, RxVoid, invocation.
     Passes: dotnet test, filtered to Ex016_ (see the exact command in
     Ex016_ReactiveCommandBasics.axaml.cs - an XML comment may not hold two
     hyphens in a row, so it cannot appear here). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:FeWoLearning.Avalonia.Exercises.Beginner"
             x:Class="FeWoLearning.Avalonia.Exercises.Beginner.Ex016_ReactiveCommandBasics"
             x:DataType="b:Ex016_ReactiveCommandBasicsViewModel">
