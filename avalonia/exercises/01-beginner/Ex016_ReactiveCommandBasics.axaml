       Command is bound to IncrementCommand, plus a TextBlock named CounterText
       showing Counter:
         <Button Name="IncrementButton" Content="Increment"
                 Command="{CompiledBinding IncrementCommand}"
                 Width="120" Height="40" />
         <TextBlock Name="CounterText" Text="{CompiledBinding Counter}" />
       Give the Button that explicit Width/Height - the test drives a real
       mouse click through the actual headless input pipeline, and the click
       point is computed from the button's own laid-out Bounds. -->
  <StackPanel Orientation="Vertical" Spacing="4">
    <Button Content="TODO" />
  </StackPanel>
</UserControl>
