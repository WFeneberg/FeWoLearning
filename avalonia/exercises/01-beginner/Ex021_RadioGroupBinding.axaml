<!-- Exercise 021 - RadioGroupBinding (beginner).
     Goal:   Two-way bind a group of RadioButtons to a single enum-typed property.
     Drills: RadioButton GroupName, enum-backed selection.
     Passes: dotnet test, filtered to Ex021_ (see the exact command in
     Ex021_RadioGroupBinding.axaml.cs - an XML comment may not hold two
     hyphens in a row, so it cannot appear here). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:FeWoLearning.Avalonia.Exercises.Beginner"
             x:Class="FeWoLearning.Avalonia.Exercises.Beginner.Ex021_RadioGroupBinding"
             x:DataType="b:Ex021_RadioGroupBindingViewModel">
  <!-- TODO: Ex021_EnumMatchConverter (in the code-behind) is part of this
       exercise's deliverable, not a helper handed to you - implement it
       (Convert: true when the bound enum equals the ConverterParameter;
       ConvertBack: the parameter when the RadioButton was just checked,
       otherwise BindingOperations.DoNothing - NOT a default enum value, and
       NOT null), declare it as a resource, and bind two RadioButtons sharing one
       GroupName, each matched to a different Ex021_Choice member via
       {x:Static}:
         <UserControl.Resources>
           <b:Ex021_EnumMatchConverter x:Key="Match" />
         </UserControl.Resources>
         <RadioButton Name="AlphaRadio" GroupName="Choice" Content="Alpha"
                      Width="160" Height="32"
                      IsChecked="{CompiledBinding Selected, Converter={StaticResource Match},
                                  ConverterParameter={x:Static b:Ex021_Choice.Alpha}, Mode=TwoWay}" />
         <RadioButton Name="BetaRadio" GroupName="Choice" Content="Beta"
                      Width="160" Height="32"
                      IsChecked="{CompiledBinding Selected, Converter={StaticResource Match},
                                  ConverterParameter={x:Static b:Ex021_Choice.Beta}, Mode=TwoWay}" />
       The DoNothing branch is the exercise's real subject: a RadioButton
       being unchecked also raises ConvertBack with false, and every group
       member but the one just checked fires that false transition. Writing
       anything other than DoNothing for false lets that unchecking write
       clobber the selection the checking RadioButton just made. IsChecked
       must be bound Mode=TwoWay - a OneWay binding driven by a code-behind
       Click handler never calls ConvertBack at all, and this exercise is
       tested directly against ConvertBack's return value as well as through
       the UI, so that shortcut does not pass. -->
  <StackPanel Orientation="Vertical" Spacing="4">
    <RadioButton Content="TODO" />
  </StackPanel>
</UserControl>
