<!-- Exercise 025 - ItemsControlTemplate (beginner).
     Goal:   Render a bound collection through an ItemsControl and a DataTemplate.
     Drills: ItemsControl with a DataTemplate.
     Passes: dotnet test, filtered to Ex025_ (see the exact command in
     Ex025_ItemsControlTemplate.axaml.cs - an XML comment may not hold two
     hyphens in a row, so it cannot appear here). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:FeWoLearning.Avalonia.Exercises.Beginner"
             x:Class="FeWoLearning.Avalonia.Exercises.Beginner.Ex025_ItemsControlTemplate"
             x:DataType="b:Ex025_ItemsControlTemplateViewModel">
  <!-- TODO: replace this placeholder with a single ItemsControl named
       Fruits, its ItemsSource bound to Items, and an ItemTemplate that
       renders each string item through a TextBlock:
         <ItemsControl Name="Fruits" ItemsSource="{CompiledBinding Items}">
           <ItemsControl.ItemTemplate>
             <DataTemplate x:DataType="x:String">
               <TextBlock Text="{CompiledBinding}" />
             </DataTemplate>
           </ItemsControl.ItemTemplate>
         </ItemsControl>
       A hard-coded StackPanel of TextBlocks can reproduce the same visual
       output with no ItemsControl and no DataTemplate at all - the test
       looks up a control specifically typed ItemsControl by name (a
       StackPanel by that name would not satisfy that lookup), and separately
       proves the binding is live by adding to the view model's collection
       and checking a new TextBlock appears - something a hard-coded panel
       can never do. -->
  <StackPanel>
    <TextBlock Text="TODO" />
  </StackPanel>
</UserControl>
