<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FeWoLearning.Avalonia.Exercises.Intermediate"
             x:Class="FeWoLearning.Avalonia.Exercises.Intermediate.Ex061_ControlTemplateBinding">
  <UserControl.Resources>
    <ControlTheme x:Key="GaugeTheme" TargetType="i:Ex061_Gauge">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Accent}"
                  Padding="8">
            <TextBlock Name="PART_Caption" Text="{TemplateBinding Caption}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <StackPanel>
    <i:Ex061_Gauge Name="Gauge"
                   Theme="{StaticResource GaugeTheme}"
                   Caption="Gauge A"
                   Accent="#FF3366" />
  </StackPanel>
</UserControl>
