<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FeWoLearning.Avalonia.Exercises.Intermediate.Ex065_RenderTransformAnimation">
  <StackPanel Spacing="8">
    <StackPanel.Styles>
      <Style Selector="Border#Spinner">
        <Style.Animations>
          <Animation Duration="0:0:5" IterationCount="Infinite">
            <KeyFrame Cue="0%">
              <Setter Property="RotateTransform.Angle" Value="0.0" />
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="RotateTransform.Angle" Value="360.0" />
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </StackPanel.Styles>

    <Border Name="Spinner"
            Width="40" Height="40"
            Background="#FF3366"
            RenderTransformOrigin="50%,50%" />

    <Border Name="Scaled" Width="40" Height="40" Background="#CCCCCC">
      <Border.RenderTransform>
        <ScaleTransform ScaleX="2" ScaleY="3" />
      </Border.RenderTransform>
    </Border>
  </StackPanel>
</UserControl>
