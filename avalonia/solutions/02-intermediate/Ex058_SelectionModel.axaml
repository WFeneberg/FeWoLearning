<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FeWoLearning.Avalonia.Exercises.Intermediate"
             x:Class="FeWoLearning.Avalonia.Exercises.Intermediate.Ex058_SelectionModel"
             x:DataType="i:Ex058_SelectionModelViewModel">
  <ListBox Name="List" ItemsSource="{Binding Items}" Selection="{Binding Selection}" />
</UserControl>
