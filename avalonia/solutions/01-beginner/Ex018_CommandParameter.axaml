<!-- Exercise 018 - CommandParameter (beginner).
     Goal:   Route two different literal parameters into the same
             ReactiveCommand via CommandParameter.
     Drills: ReactiveCommand<TParam, RxVoid>, CommandParameter.
     Passes: dotnet test, filtered to Ex018_ (see the exact command in
     Ex018_CommandParameter.axaml.cs - an XML comment may not hold two
     hyphens in a row, so it cannot appear here). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:FeWoLearning.Avalonia.Exercises.Beginner"
             x:Class="FeWoLearning.Avalonia.Exercises.Beginner.Ex018_CommandParameter"
             x:DataType="b:Ex018_CommandParameterViewModel">
  <StackPanel Orientation="Vertical" Spacing="4">
    <Button Name="AlphaButton" Content="Alpha"
            Command="{CompiledBinding SetParameterCommand}"
            CommandParameter="alpha" Width="120" Height="40" />
    <Button Name="BetaButton" Content="Beta"
            Command="{CompiledBinding SetParameterCommand}"
            CommandParameter="beta" Width="120" Height="40" />
  </StackPanel>
</UserControl>
