<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>FeWoLearning.Uno.Exercises</RootNamespace>
    <AssemblyName>FeWoLearning.Uno.Solutions</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>Skia</UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generic host, DI, configuration and options (ex068, ex095). -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

</Project>
