<UserControl
    x:Class="FeWoLearning.Uno.Exercises.Beginner.Ex035_XBindBasics"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="Root">
        <!-- No Mode, so OneTime: evaluated while the tree is built and then never again. -->
        <TextBlock x:Name="Once" Text="{x:Bind Caption}" />

        <!-- The opt-in that {Binding} would have given for free. -->
        <TextBlock x:Name="Live" Text="{x:Bind Caption, Mode=OneWay}" />

        <!-- x:Bind can call a method; a classic {Binding} needs a converter for this. -->
        <TextBlock x:Name="Computed" Text="{x:Bind Shout()}" />
    </StackPanel>

</UserControl>
