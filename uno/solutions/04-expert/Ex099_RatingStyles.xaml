<ResourceDictionary
    x:Class="FeWoLearning.Uno.Exercises.Expert.Ex099_RatingStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FeWoLearning.Uno.Exercises.Expert">

    <Style TargetType="local:Ex099_RatingControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:Ex099_RatingControl">
                    <StackPanel x:Name="PART_Root">
                        <Button x:Name="PART_Increment" Content="+" />
                        <Border x:Name="PART_Fill" Width="20" Height="10" Opacity="1" />

                        <VisualStateManager.VisualStateGroups>
                            <!-- Orthogonal on purpose: a read-only control can be rated,
                                 and an editable one can be empty. One group for both would
                                 need a state per combination. -->
                            <VisualStateGroup x:Name="AvailabilityStates">
                                <VisualState x:Name="Editable" />
                                <VisualState x:Name="ReadOnly">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Increment.IsEnabled" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="RatingStates">
                                <VisualState x:Name="Empty" />
                                <VisualState x:Name="Rated">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Fill.Width" Value="60" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
