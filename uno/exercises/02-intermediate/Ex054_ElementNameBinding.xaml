<UserControl
    x:Class="FeWoLearning.Uno.Exercises.Intermediate.Ex054_ElementNameBinding"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TODO: Ex054 - bind elements to each other by name.

        A StackPanel named "Root" holding:
          * a TextBlock named "Source" with Text="the source",
          * a TextBlock named "Mirror" whose Text is bound with
            {Binding ElementName=Source, Path=Text},
          * a Border named "Sized" whose Width is bound to the Slider's Value with
            {Binding ElementName=Dial, Path=Value} and whose Height is 10,
          * a Slider named "Dial" with Minimum="0" Maximum="200" Value="40".

        Note the last two: "Sized" refers to "Dial" before "Dial" appears in the document.
        A name scope is resolved after the whole scope is built, not line by line - which
        is also why an ElementName that never appears fails silently rather than at parse
        time.
    -->

</UserControl>
